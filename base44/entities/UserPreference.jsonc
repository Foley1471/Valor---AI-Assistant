{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "preferred_name": {
      "type": "string",
      "description": "What the assistant should call the user"
    },
    "assistant_name": {
      "type": "string",
      "description": "The user's chosen assistant name"
    },
    "personality": {
      "type": "string",
      "enum": [
        "professional",
        "friendly",
        "calm",
        "witty",
        "technical"
      ],
      "default": "friendly"
    },
    "voice": {
      "type": "string",
      "description": "Selected speech synthesis voice URI or name"
    },
    "speech_rate": {
      "type": "number",
      "default": 1,
      "description": "Speech rate multiplier"
    },
    "speech_pitch": {
      "type": "number",
      "default": 1,
      "description": "Speech pitch multiplier"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "first_greeting_done": {
      "type": "boolean",
      "default": false
    },
    "memory_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}